{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sagetube",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",

  // ./public holds only styles.css and app.js. There is deliberately no
  // index.html: every HTML page is server-rendered by the Worker so crawlers
  // get real markup, so unmatched paths must fall through instead of being
  // answered by the asset layer.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },

  "observability": {
    "enabled": true
  },

  // YT_PROXY_URL and YT_MEDIA_PROXY_URL are deliberately NOT declared here.
  // They carry the relay's auth token, so they are set as secrets:
  //
  //   npx wrangler secret put YT_PROXY_URL
  //   npx wrangler secret put YT_MEDIA_PROXY_URL
  //   value: https://<relay-host>/fetch?token=<secret>&url={url}
  //
  // Declaring them as plain vars here would also block the secret, since a
  // secret cannot share a name with an existing var binding.
  //
  // Both must point at the SAME machine: googlevideo signs the minting IP into
  // the stream URL, so the media fetch has to leave from the address that
  // minted it. Unset = call YouTube directly (downloads then fail for most
  // videos; see README).
}
