{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sagetube",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",

  // ./public holds only styles.css and app.js. There is deliberately no
  // index.html: every HTML page is server-rendered by the Worker so crawlers
  // get real markup, so unmatched paths must fall through instead of being
  // answered by the asset layer.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },

  "observability": {
    "enabled": true
  },

  "vars": {
    // Optional relay for InnerTube (metadata) calls. Two shapes work:
    //   "https://relay.example.com/fetch?url={url}"  - template style
    //   "https://relay.example.com"                  - mirrors youtube.com paths
    // Empty = call YouTube directly from the Worker.
    "YT_PROXY_URL": "",

    // Optional relay for googlevideo (media) requests. googlevideo signs the
    // minting IP into the stream URL, so downloads only succeed when the media
    // fetch leaves from the same address that minted it — this must therefore
    // point at the SAME machine as YT_PROXY_URL. Only the {url} template shape
    // works here. Defaults to YT_PROXY_URL when that is a {url} template.
    "YT_MEDIA_PROXY_URL": ""
  }
}
